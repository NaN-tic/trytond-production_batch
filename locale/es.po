msgctxt "model:ir.message,text:msg_invalid_batch_multiple"
msgid ""
"Production \"%(production)s\" quantity %(quantity)s %(unit)s must be a "
"multiple of batch %(batch_quantity)s %(batch_uom)s."
msgstr ""
"La cantidad %(quantity)s %(unit)s de la orden de producción "
"\"%(production)s\" debe ser múltiplo del lote %(batch_quantity)s "
"%(batch_uom)s."

